{
  "name": "modellio",
  "private": true,
  "version": "0.1.0",
  "description": "MODELLIO — Make anything. Shape everything. A browser-based 3D CAD modeller.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/run-e2e.mjs",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\"",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/roboto-slab": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@supabase/supabase-js": "^2.119.0",
    "fflate": "^0.8.3",
    "immer": "^11.2.10",
    "lucide-react": "^1.72.0",
    "manifold-3d": "^3.5.4",
    "opentype.js": "^1.3.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "saxes": "^6.0.0",
    "three": "^0.187.0",
    "three-stdlib": "^2.36.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@3mfconsortium/lib3mf": "^2.5.0-fix.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "playwright": "^1.63.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
